# Required: Remote PostgreSQL / Prisma Accelerate connection string
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_KEY"

# Required: Secret for signing JWTs — use a long random string
JWT_SECRET="change-me-to-a-long-random-secret"

# Optional (default: 1h)
JWT_EXPIRES_IN="1h"
