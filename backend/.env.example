# Required: Remote PostgreSQL / Prisma Accelerate connection string
DATABASE_URL=""

# Required: Secret for signing JWTs — use a long random string
JWT_SECRET=""

# Optional (default: 1h)
JWT_EXPIRES_IN="1h"

# API gateway port (default: 3001)
PORT=3001

# Frontend URL for CORS (optional, defaults to http://localhost:3000)
FRONTEND_URL="http://localhost:3000"

# Moleculer log level
LOG_LEVEL="info"
